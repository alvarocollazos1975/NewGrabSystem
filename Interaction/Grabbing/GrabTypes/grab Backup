using UnityEngine;
using System.Collections.Generic;

namespace BIMOS
{
    [AddComponentMenu("BIMOS/Grabs/Grab (Basic)")]
    public class Grab : MonoBehaviour
    {
        [HideInInspector]
        public Hand LeftHand, RightHand;

        public HandPose HandPose;
        public delegate void Release();
        public event Release ReleaseEvent;
        public bool IsLeftHanded = true, IsRightHanded = true;
        public Grab[] EnableGrabs, DisableGrabs;

        public List<GrabPoint> grabPoints = new List<GrabPoint>();

        private Rigidbody _rigidBody;
        private ArticulationBody _articulationBody;
        private Transform _body;

        [HideInInspector]
        public Collider Collider;

        protected Transform primaryGrabOffset;
                protected List<GrabHandler> heldByGrabbers = new List<GrabHandler>();

        public List<GrabHandler> HeldByGrabbers
        {
            get
            {
                return heldByGrabbers;
            }
        }

        private void OnEnable()
        {
            _body = Utilities.GetBody(transform, out _rigidBody, out _articulationBody);
            if (!_body)
            {
                Rigidbody rigidbody = gameObject.AddComponent<Rigidbody>();
                rigidbody.isKinematic = true;
                _rigidBody = rigidbody;
                _body = _rigidBody.transform;
            }

            Collider = GetComponent<Collider>();
            if (Collider == null)
            {
                CreateCollider();
            }

            // Actualizar puntos de agarre
            UpdateGrabPoints();
        }

        public virtual void CreateCollider()
        {
            SphereCollider collider = gameObject.AddComponent<SphereCollider>();
            collider.isTrigger = true;
            collider.radius = 0.01f;
            Collider = collider;
        }

        public virtual void UpdateGrabPoints()
        {
            foreach (GrabPoint grabPoint in grabPoints)
            {
                grabPoint.primaryGrabOffset = grabPoint.transform;
            }
        }

        public virtual Transform GetClosestGrabPoint(Transform handTransform)
        {
            Transform closestPoint = null;
            float closestDistance = float.MaxValue;

            foreach (GrabPoint grabPoint in grabPoints)
            {
                if ((handTransform.GetComponent<Hand>().IsLeftHand && grabPoint.IsLeftHanded) || (!handTransform.GetComponent<Hand>().IsLeftHand && grabPoint.IsRightHanded))
                {
                    float distance = Vector3.Distance(handTransform.position, grabPoint.transform.position);
                    if (distance < closestDistance)
                    {
                        closestDistance = distance;
                        closestPoint = grabPoint.transform;
                    }
                }
            }

            return closestPoint;
        }

        public virtual float CalculateRank(Transform handTransform)
        {
            if (Collider is MeshCollider)
                return 1f / 1000f;

            return 1f / Vector3.Distance(handTransform.position, Collider.ClosestPoint(handTransform.position));
        }

        public virtual void OnGrab(Hand hand)
        {
            hand.CurrentGrab = this;

            GrabHandler grabHandler = hand.GetComponent<GrabHandler>();
            if (grabHandler && !heldByGrabbers.Contains(grabHandler))
            {
                heldByGrabbers.Add(grabHandler);
            }

            Transform closestGrabPoint = GetClosestGrabPoint(hand.transform);
            if (closestGrabPoint != null)
            {
                primaryGrabOffset = closestGrabPoint;

                GrabPoint grabPoint = closestGrabPoint.GetComponent<GrabPoint>();
                grabPoint.AssignHand(hand);

                if (hand.IsLeftHand)
                {
                    LeftHand = hand;
                    if (RightHand != null)
                    {
                        RightHand.enabled = false; // Deshabilitar la otra mano
                    }
                }
                else
                {
                    RightHand = hand;
                    if (LeftHand != null)
                    {
                        LeftHand.enabled = false; // Deshabilitar la otra mano
                    }
                }

                AttachHandToGrabPoint(hand);
                CreateGrabJoint(hand);
                IgnoreCollision(hand, true);
            }

            GetComponent<Interactable>()?.OnGrab();
        }

        public virtual void OnRelease(Hand hand, bool toggleGrabs)
        {
            if (hand == null)
                return;

            GrabHandler grabHandler = hand.GetComponent<GrabHandler>();
            if (grabHandler && heldByGrabbers.Contains(grabHandler))
            {
                heldByGrabbers.Remove(grabHandler);
            }

            DetachHandFromGrabPoint(hand);
            DestroyGrabJoint(hand);
            IgnoreCollision(hand, false);

            GrabPoint grabPoint = primaryGrabOffset.GetComponent<GrabPoint>();
            grabPoint.ReleaseHand(hand);

            if (hand.IsLeftHand)
            {
                LeftHand = null;
                if (RightHand != null)
                {
                    RightHand.enabled = true; // Habilitar la otra mano
                }
            }
            else
            {
                RightHand = null;
                if (LeftHand != null)
                {
                    LeftHand.enabled = true; // Habilitar la otra mano
                }
            }

            GetComponent<Interactable>()?.OnRelease();

            hand.CurrentGrab = null;

            ReleaseEvent?.Invoke();
        }

        public virtual void IgnoreCollision(Hand hand, bool ignore)
        {
            foreach (Collider collider in _body.GetComponentsInChildren<Collider>())
            {
                Physics.IgnoreCollision(collider, hand.PhysicsHandCollider, ignore);
            }
        }

        public virtual void AlignHand(Hand hand) { }

        public virtual void DestroyGrabJoint(Hand hand)
        {
            if (hand == null)
                return;

            FixedJoint grabJoint = hand.PhysicsHandTransform.GetComponent<FixedJoint>();
            grabJoint.anchor = Vector3.zero;
