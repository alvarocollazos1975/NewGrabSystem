        {
            if (hand == null)
                return;

            FixedJoint grabJoint = hand.PhysicsHandTransform.GetComponent<FixedJoint>();
            Destroy(grabJoint);

            IgnoreCollision(hand, false);
        }

        private void FixedUpdate()
        {
            UpdateTwoHandedRotation();
        }

        private void UpdateTwoHandedRotation()
        {
            if (LeftHand != null && RightHand != null)
            {
                Vector3 midpoint = (LeftHand.transform.position + RightHand.transform.position) / 2;
                _rigidBody.MovePosition(midpoint);

                Quaternion targetRotation = Quaternion.Slerp(LeftHand.transform.rotation, RightHand.transform.rotation, 0.5f);
