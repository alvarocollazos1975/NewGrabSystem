            FixedJoint grabJoint = hand.PhysicsHandTransform.gameObject.AddComponent<FixedJoint>();
            grabJoint.enableCollision = true;
            grabJoint.breakForce = Mathf.Infinity; // Ajustado para mayor firmeza
            grabJoint.breakTorque = Mathf.Infinity; // Ajustado para mayor firmeza
            grabJoint.enablePreprocessing = false;
            // grabJoint.autoConfigureConnectedAnchor = false;
              //  grabJoint.anchor = Vector3.zero;
              //  grabJoint.connectedAnchor = GrabPositionOffset;

            if (_rigidBody != null)
                grabJoint.connectedBody = _rigidBody;
            if (_articulationBody != null)
                grabJoint.connectedArticulationBody = _articulationBody;
        }

        public void OnRelease(Hand hand, bool toggleGrabs)
        {
            if (hand == null)
                return;

            GrabHandler grabHandler = hand.GetComponent<GrabHandler>();
            if (grabHandler && heldByGrabbers.Contains(grabHandler))
            {
                heldByGrabbers.Remove(grabHandler);
            }

            DetachHandFromGrabPoint(hand);

            DestroyGrabJoint(hand);

            if (toggleGrabs)
            {
                foreach (Grab grab in EnableGrabs)
                {
                    if (grab != null)
                        grab.enabled = false;
                }
                foreach (Grab grab in DisableGrabs)
                {
                    if (grab != null)
                        grab.enabled = true;
                }
