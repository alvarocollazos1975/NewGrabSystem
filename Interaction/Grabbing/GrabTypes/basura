       public virtual GrabHandler GetPrimaryGrabber(Hand hand)
        {
            if (heldByGrabbers != null)
            {
                foreach (var grabber in heldByGrabbers)
                {
                    if (grabber != null && grabber._chosenGrab == this)
                    {
                        return grabber;
                    }
                }
            }

            return null;
        }

        

        /// <summary>
        /// Método que se ejecuta cuando el objeto comienza a ser agarrado.
        /// Este método puede ser sobrescrito en clases derivadas.
        /// </summary>
        /// <param name="hand">La mano que realiza el agarre.</param>
       public virtual void OnGrab(Hand hand)
        {
            hand.CurrentGrab = this;

            GrabHandler grabHandler = hand.GetComponent<GrabHandler>();
            if (grabHandler && !heldByGrabbers.Contains(grabHandler))
            {
                heldByGrabbers.Add(grabHandler);
            }

            if (hand.IsLeftHand)
                LeftHand = hand;
            else
                RightHand = hand;            

            AlignObjectToHand(hand);

            AttachHandToGrabPoint(hand);

            hand.GrabHandler.ApplyGrabPose(HandPose);

            AlignHand(hand);
            // Sincronizar la posición global del objeto con la mano
           // AlignObjectToHand(hand);

            if (GrabMechanic == HandType.Slider)
            {
                CreateGrabJoint(hand, HandType.Slider); // Para el slider
            }
            if (GrabMechanic == HandType.Grip)
            {
                CreateGrabJoint(hand, HandType.Grip); // Para el grip
            }
           
           // CreateGrabJoint(hand);

            IgnoreCollision(hand, true);

            foreach (Grab grab in EnableGrabs)
            {
                if (grab)
                    grab.enabled = true;
            }
            foreach (Grab grab in DisableGrabs)
            {
                if (grab)
                    grab.enabled = false;
            }


            GetComponent<Interactable>()?.OnGrab();
            Debug.Log($"{gameObject.name} ha sido agarrado por {hand.name}.");
        }

         public virtual void IgnoreCollision(Hand hand, bool ignore)
        {
            foreach (Collider collider in _body.GetComponentsInChildren<Collider>())
            {
                Physics.IgnoreCollision(collider, hand.PhysicsHandCollider, ignore);
            }
        }

        private void CreateGrabJoint(Hand hand)
        {
            FixedJoint grabJoint = hand.PhysicsHandTransform.gameObject.AddComponent<FixedJoint>();
           

            if (_rigidBody != null)
                grabJoint.connectedBody = _rigidBody;
            if (_articulationBody != null)
                grabJoint.connectedArticulationBody = _articulationBody; 
               if (GrabMechanic == HandType.Slider) {
                // Just let the autoconfigure handle the calculations for us
                grabJoint.autoConfigureConnectedAnchor = true;
            }
            // Setup the snap point manually
            else if (GrabMechanic == HandType.Grip) {
                 grabJoint.autoConfigureConnectedAnchor = false;
                 grabJoint.anchor = Vector3.zero; // Punto de unión en la mano

                  // Asignar el offset calculado correctamente
                grabJoint.connectedAnchor = _body.InverseTransformPoint(primaryGrabOffset.position);
               
            }
        }

        public void CreateGrabJoint(Hand hand, HandType grabMechanic)
        {
            // Evita crear múltiples joints para la misma mano
            if (grabbingHands.Contains(hand))
            {
                Debug.LogWarning("Esta mano ya está agarrando el objeto.");
                return;
            }

            // Crear un ConfigurableJoint
            ConfigurableJoint joint = hand.PhysicsHandTransform.gameObject.AddComponent<ConfigurableJoint>();


            // Configurar el cuerpo conectado
            if (_rigidBody != null)
                joint.connectedBody = _rigidBody;
            if (_articulationBody != null)
                joint.connectedArticulationBody = _articulationBody;


                 if (GrabMechanic == HandType.Slider)
                    {
                        joint.autoConfigureConnectedAnchor = true;
                        
                    }
                    if (GrabMechanic == HandType.Grip)
                    {

                         // Configuración general
                        joint.autoConfigureConnectedAnchor = false;
                        joint.anchor = Vector3.zero; // Punto en la mano
                        joint.connectedAnchor = _body.InverseTransformPoint(primaryGrabOffset.position); // Offset relativo al objeto
                        
                    }



           

            // Configuración específica del tipo de agarre
            switch (grabMechanic)
            {
                case HandType.Grip:
                    joint.xMotion = ConfigurableJointMotion.Locked;
                    joint.yMotion = ConfigurableJointMotion.Locked;
                    joint.zMotion = ConfigurableJointMotion.Locked;
                    joint.angularXMotion = ConfigurableJointMotion.Locked;
                    joint.angularYMotion = ConfigurableJointMotion.Locked;
                    joint.angularZMotion = ConfigurableJointMotion.Locked;
                    break;

                case HandType.Slider:
                    joint.xMotion = ConfigurableJointMotion.Limited;
                    joint.yMotion = ConfigurableJointMotion.Locked;
                    joint.zMotion = ConfigurableJointMotion.Locked;

                    // Limitar el movimiento en el eje X
                    SoftJointLimit limit = new SoftJointLimit { limit = 0.1f }; // Ajustar el límite
                    joint.linearLimit = limit;

                    // Configuración adicional de rigidez y amortiguación
                    joint.linearLimitSpring = new SoftJointLimitSpring
                    {
                        spring = 100f, // Rigidez
                        damper = 10f   // Amortiguación
                    };
                    break;
            }

            // Registrar la mano y el joint
            grabbingHands.Add(hand);
            handJoints[hand] = joint;
            handTypes[hand] = grabMechanic;

            Debug.Log($"Joint creado para {grabMechanic}. Offset: {primaryGrabOffset.position}");
        }

        public void ReleaseGrabJoint(Hand hand)
        {
            // Si la mano no está agarrando, no hacer nada
            if (!grabbingHands.Contains(hand))
            {
                Debug.LogWarning("Esta mano no está agarrando el objeto.");
                return;
            }

            // Eliminar el joint correspondiente
            if (handJoints.TryGetValue(hand, out ConfigurableJoint joint))
            {
                Destroy(joint);
            }

            // Limpiar las referencias
            grabbingHands.Remove(hand);
            handJoints.Remove(hand);
            handTypes.Remove(hand);
        }


        /// <summary>
        /// Método que se ejecuta cuando el objeto deja de ser agarrado.
        /// Este método puede ser sobrescrito en clases derivadas.
        /// </summary>
        /// <param name="hand">La mano que suelta el objeto.</param>
        public virtual void OnRelease(Hand hand, bool toggleGrabs)
        {
            
            if (hand == null)
                return;

            GrabHandler grabHandler = hand.GetComponent<GrabHandler>();
            if (grabHandler && heldByGrabbers.Contains(grabHandler))
            {
                heldByGrabbers.Remove(grabHandler);
            }

             PhysicsHand physicsHand = hand.GetComponent<PhysicsHand>();
            if (physicsHand != null)
            {
                physicsHand.ResetOffsets();
            }

            DetachHandFromGrabPoint(hand);

            //DestroyGrabJoint(hand);
            ReleaseGrabJoint(hand);
           
           //primaryGrabOffset=null;

           
            if (toggleGrabs)
            {
                foreach (Grab grab in EnableGrabs)
                {
                    if (grab)
                        grab.enabled = false;
                }
                foreach (Grab grab in DisableGrabs)
                {
                    if (grab)
                        grab.enabled = true;
                }
            }


            GetComponent<Interactable>()?.OnRelease();

            hand.CurrentGrab = null;

            if (hand.IsLeftHand)
                LeftHand = null;
            else
                RightHand = null;

            ReleaseEvent?.Invoke();
            Debug.Log($"{gameObject.name} ha sido soltado por {hand.name}.");
        }       

         public virtual void DestroyGrabJoint(Hand hand)
        {
            if (hand == null)
                return;
                 FixedJoint grabJoint = hand.PhysicsHandTransform.GetComponent<FixedJoint>();

            if (GrabMechanic == HandType.Slider) {               
                grabJoint.anchor = Vector3.zero;  
            }

            Destroy(grabJoint);           

            IgnoreCollision(hand, false);
        }

       

        private void OnDisable()
        {
            OnRelease(LeftHand, false);
            OnRelease(RightHand, false);
        }

       private void AttachHandToGrabPoint(Hand hand)
        {
            hand.transform.SetParent(primaryGrabOffset); // Asignar al grab point
            hand.transform.localPosition = Vector3.zero; // Sin offset de posición
            hand.transform.localRotation = Quaternion.identity; // Sin offset de rotación
        }

        private void DetachHandFromGrabPoint(Hand hand)
        {
            hand.transform.SetParent(null);
        }

        public virtual void CreateCollider()
        {
            SphereCollider collider = gameObject.AddComponent<SphereCollider>();
            collider.isTrigger = true;
            collider.radius = 0.01f;
            Collider = collider;
        }
      
          private void CreateGrabPoint()
        {
            if (primaryGrabOffset == null)
            {
                primaryGrabOffset = new GameObject("Primary Grab Point").transform;
                primaryGrabOffset.SetParent(this.transform);
                primaryGrabOffset.localPosition = Vector3.zero;
            }

        }

       private void AlignObjectToHand(Hand hand)
        {
            if (primaryGrabOffset != null)
            {
                // Mover el objeto para alinear su posición con la mano
                transform.position = hand.PhysicsHandTransform.position;

                // Ajustar la rotación del objeto para que coincida con la mano
                transform.rotation = hand.PhysicsHandTransform.rotation * Quaternion.Inverse(primaryGrabOffset.localRotation);
            }
        }



