                Transform closestGrabPoint = GetClosestGrabPoint();
                if (closestGrabPoint != null)
                {
                    primaryGrabOffset.localPosition = closestGrabPoint.localPosition;
                    primaryGrabOffset.localRotation = closestGrabPoint.localRotation;
